---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import {SOCIAL_LINKS} from '../consts';
import {getCollection} from "astro:content";


const campaigns = await getCollection('campaigns');
---

<BaseLayout
	title="Contact | Get in Touch"
	description="Have questions about campaigns, services, or custom adventures? Reach out and let's start a conversation."
>
	<!-- Hero Section -->
	<section class="relative bg-gradient-to-br from-[#fdf4f5] via-white to-[#f0fdfc] py-20 md:py-32">
		<div class="max-w-screen-xl mx-auto px-6">
			<div class="max-w-4xl mx-auto text-center">
				<h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-bold mb-6">
					Let's Talk
					<span class="block bg-gradient-to-r from-[#9c2d4b] to-[#107574] bg-clip-text text-transparent">
            About Your Next Adventure
          </span>
				</h1>
				<p class="text-xl md:text-2xl text-stone-600 leading-relaxed">
					Questions about campaigns, custom adventures, or just want to chat about Pathfinder 2E? I'd love to
					hear from you.
				</p>
			</div>
		</div>
	</section>

	<!-- Contact Content -->
	<Section background="white" padding="xl">
		<div class="max-w-5xl mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
				<!-- Contact Form -->
				<div>
					<h2 class="text-3xl font-display font-semibold mb-6">Send a Message</h2>
					<form class="space-y-6" method="POST" action="https://formspree.io/f/mnnevryk">
						<div>
							<label for="name" class="block text-sm font-medium text-stone-700 mb-2">
								Name *
							</label>
							<input
								type="text"
								id="name"
								name="name"
								required
								class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:ring-2 focus:ring-[#b93d5e] focus:border-transparent transition-all"
								placeholder="Your name"
							/>
						</div>

						<div>
							<label for="email" class="block text-sm font-medium text-stone-700 mb-2">
								Email *
							</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:ring-2 focus:ring-[#b93d5e] focus:border-transparent transition-all"
								placeholder="your.email@example.com"
							/>
						</div>

						<div>
							<label for="subject" class="block text-sm font-medium text-stone-700 mb-2">
								Subject *
							</label>
							<select
								id="subject"
								name="subject"
								required
								class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:ring-2 focus:ring-[#b93d5e] focus:border-transparent transition-all"
							>
								<option value="">Select a topic...</option>
								<option value="campaign-inquiry">Campaign Inquiry</option>
								<option value="custom-adventure">Custom Adventure Request</option>
								<option value="general-question">General Question</option>
								<option value="technical-issue">Technical Issue</option>
								<option value="other">Other</option>
							</select>
						</div>

						<div>
							<label for="campaign" class="block text-sm font-medium text-stone-700 mb-2">
								Campaign *
							</label>
							<select
								id="campaign"
								name="campaign"
								class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:ring-2 focus:ring-[#b93d5e] focus:border-transparent transition-all"
							>
								<option value="">Select a campaign</option>
								{campaigns.map(campaign =>
									<option value={campaign.id}>{campaign.data.title}</option>)}
							</select>
						</div>

						<div>
							<label for="message" class="block text-sm font-medium text-stone-700 mb-2">
								Message *
							</label>
							<textarea
								id="message"
								name="message"
								required
								rows="6"
								class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:ring-2 focus:ring-[#b93d5e] focus:border-transparent transition-all resize-none"
								placeholder="Tell me about your inquiry..."
							></textarea>
						</div>

						<Button variant="primary" type="submit" size="lg" class="w-full">
							Send Message
						</Button>
					</form>
				</div>

				<!-- Contact Info & FAQ -->
				<div class="space-y-8">
					<div>
						<h2 class="text-3xl font-display font-semibold mb-6">Other Ways to Connect</h2>

						<div class="space-y-4">
							{SOCIAL_LINKS.discord && (
								<a
									href={SOCIAL_LINKS.discord}
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center gap-4 p-4 bg-gradient-to-br from-[#fbe8eb] to-[#fdf4f5] rounded-xl hover:shadow-lg transition-all group"
								>
									<div
										class="w-12 h-12 rounded-full bg-[#5865F2] flex items-center justify-center text-white text-xl">
										💬
									</div>
									<div class="flex-1">
										<div
											class="font-semibold text-stone-900 group-hover:text-[#b93d5e] transition-colors">
											Discord
										</div>
										<div class="text-sm text-stone-600">Join the community server</div>
									</div>
								</a>
							)}

							{SOCIAL_LINKS.email && (
								<a
									href={`mailto:${SOCIAL_LINKS.email}`}
									class="flex items-center gap-4 p-4 bg-gradient-to-br from-[#f0fdfc] to-[#ccfbf8] rounded-xl hover:shadow-lg transition-all group"
								>
									<div
										class="w-12 h-12 rounded-full bg-[#107574] flex items-center justify-center text-white text-xl">
										📧
									</div>
									<div class="flex-1">
										<div
											class="font-semibold text-stone-900 group-hover:text-[#107574] transition-colors">
											Email
										</div>
										<div class="text-sm text-stone-600">Direct email contact</div>
									</div>
								</a>
							)}
						</div>
					</div>

					<div class="bg-stone-50 rounded-2xl p-8 border border-stone-200">
						<h3 class="text-2xl font-display font-semibold mb-4">Quick Answers</h3>

						<div class="space-y-4">
							<div>
								<h4 class="font-semibold text-stone-900 mb-1">How do I sign up for a campaign?</h4>
								<p class="text-sm text-stone-600">
									Browse <a href="/campaigns" class="text-[#b93d5e] hover:underline">available
									campaigns</a> and click "Sign Up" on any campaign detail page.
								</p>
							</div>

							<div>
								<h4 class="font-semibold text-stone-900 mb-1">Do I need prior experience?</h4>
								<p class="text-sm text-stone-600">
									Not at all! Many campaigns are beginner-friendly, and I provide guidance for new
									players throughout.
								</p>
							</div>

							<div>
								<h4 class="font-semibold text-stone-900 mb-1">What timezone are sessions in?</h4>
								<p class="text-sm text-stone-600">
									Session times are flexible and coordinated during Session 0 to accommodate all
									players.
								</p>
							</div>

							<div>
								<h4 class="font-semibold text-stone-900 mb-1">Can I request a custom campaign?</h4>
								<p class="text-sm text-stone-600">
									Yes! Contact me with your ideas and we can discuss creating a unique adventure for
									your group.
								</p>
							</div>
						</div>
					</div>

					<div
						class="bg-gradient-to-br from-[#fffbeb] to-[#fef3c7] rounded-2xl p-6 border border-[#d97706]/20">
						<h3 class="font-display font-semibold text-stone-900 mb-2">Response Time</h3>
						<p class="text-sm text-stone-600">
							I typically respond to inquiries within 24-48 hours. If you haven't heard back, please check
							your spam folder or reach out via Discord.
						</p>
					</div>
				</div>
			</div>
		</div>
	</Section>
</BaseLayout>
