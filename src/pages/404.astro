---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
	title="Page Not Found"
	description="The page you're looking for doesn't exist."
>
	<Section background="gradient" padding="2xl">
		<div class="max-w-2xl mx-auto text-center">
			<div class="mb-8">
				<div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-white/10 backdrop-blur-sm mb-6">
					<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="12" y1="8" x2="12" y2="12"></line>
						<line x1="12" y1="16" x2="12.01" y2="16"></line>
					</svg>
				</div>
				<h1 class="font-[family-name:var(--font-family-display)] text-6xl font-bold text-white mb-4">
					404
				</h1>
				<p class="text-2xl text-white/90 mb-2">
					Page Not Found
				</p>
				<p class="text-lg text-white/70 max-w-md mx-auto">
					The page you're looking for doesn't exist or has been moved. Let's get you back on track.
				</p>
			</div>

			<div class="flex flex-wrap items-center justify-center gap-4">
				<Button variant="primary" size="lg" href="/">
					Back to Home
				</Button>
				<Button variant="outline" size="lg" href="/campaigns">
					Browse Campaigns
				</Button>
			</div>

			<div class="mt-12 pt-8 border-t border-white/20">
				<p class="text-white/60 mb-4">Popular pages:</p>
				<div class="flex flex-wrap items-center justify-center gap-3">
					<a href="/campaigns" class="text-white hover:text-white/80 underline transition-colors duration-150">
						Campaigns
					</a>
					<span class="text-white/40">•</span>
					<a href="/services" class="text-white hover:text-white/80 underline transition-colors duration-150">
						Services
					</a>
					<span class="text-white/40">•</span>
					<a href="/about" class="text-white hover:text-white/80 underline transition-colors duration-150">
						About
					</a>
					<span class="text-white/40">•</span>
					<a href="/contact" class="text-white hover:text-white/80 underline transition-colors duration-150">
						Contact
					</a>
				</div>
			</div>
		</div>
	</Section>
</BaseLayout>
