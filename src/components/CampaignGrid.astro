---
import CampaignCard from './CampaignCard.astro';

interface Props {
	campaigns: any[];
	columns?: 2 | 3 | 4;
	class?: string;
}

const {campaigns, columns = 3, class: className} = Astro.props;

const gridClasses = {
	2: 'md:grid-cols-2',
	3: 'md:grid-cols-2 lg:grid-cols-3',
	4: 'md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4'
}[columns];
---

{campaigns.length > 0 ? (
<div class={`grid grid-cols-1 ${gridClasses} gap-6 ${className || ''}`}>
	{campaigns.map((campaign) => (
		<CampaignCard campaign={campaign}/>
	))}
</div>
	) : (
<div class="text-center py-12">
	<div class="w-16 h-16 mx-auto mb-4 rounded-full bg-stone-100 flex items-center justify-center text-3xl">
		🎲
	</div>
	<h3 class="text-xl font-semibold text-stone-900 mb-2">No campaigns found</h3>
	<p class="text-stone-600">Try adjusting your filters or check back soon for new campaigns.</p>
</div>
	)}
