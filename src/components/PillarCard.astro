---
interface Props {
	icon: string;
	title: string;
	description: string;
}

const {icon, title, description} = Astro.props;
---

<div
	class="group relative bg-white rounded-2xl p-8 border border-stone-200 hover:border-[#b93d5e] transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
	<div class="flex flex-col items-start gap-4">
		<!-- Icon -->
		<div
			class="w-14 h-14 rounded-xl bg-gradient-to-br from-[#fbe8eb] to-[#fdf4f5] flex items-center justify-center text-3xl group-hover:scale-110 transition-transform duration-300">
			{icon}
		</div>

		<!-- Content -->
		<div class="flex-1">
			<h3 class="text-xl font-display font-semibold text-stone-900 mb-2">
				{title}
			</h3>
			<p class="text-stone-600 leading-relaxed">
				{description}
			</p>
		</div>
	</div>

	<!-- Hover accent line -->
	<div
		class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-[#b93d5e] to-[#9c2d4b] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 rounded-b-2xl"></div>
</div>
