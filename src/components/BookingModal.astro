---
import Button from './Button.astro';
import { FORMSPREE_ENDPOINT } from '../consts';

interface Props {
	campaignId?: string;
	campaignTitle?: string;
}

const { campaignId, campaignTitle } = Astro.props;
---

<dialog id="booking-modal" class="booking-modal mx-auto">
	<div class="modal-backdrop"></div>
	<div class="modal-content">
		<div class="modal-header">
			<h2 class="text-2xl font-display font-semibold text-stone-900">
				{campaignTitle ? `Sign Up for ${campaignTitle}` : 'Sign Up for Campaign'}
			</h2>
			<button id="close-modal" class="close-button" aria-label="Close modal">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>

		<form id="booking-form" class="modal-body" method="POST" action={FORMSPREE_ENDPOINT}>
			<input type="hidden" name="form-type" value="booking" />
			<input type="hidden" name="campaign" id="booking-campaign" value={campaignId || ''} />

			<div class="space-y-5">
				<div>
					<label for="booking-name" class="block text-sm font-medium text-stone-700 mb-2">
						Name *
					</label>
					<input
						type="text"
						id="booking-name"
						name="name"
						required
						class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:ring-2 focus:ring-[#b93d5e] focus:border-transparent transition-all"
						placeholder="Your name"
					/>
				</div>

				<div>
					<label for="booking-email" class="block text-sm font-medium text-stone-700 mb-2">
						Email *
					</label>
					<input
						type="email"
						id="booking-email"
						name="email"
						required
						class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:ring-2 focus:ring-[#b93d5e] focus:border-transparent transition-all"
						placeholder="your.email@example.com"
					/>
				</div>

				<div>
					<label for="booking-discord" class="block text-sm font-medium text-stone-700 mb-2">
						Discord Username
					</label>
					<input
						type="text"
						id="booking-discord"
						name="discord"
						class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:ring-2 focus:ring-[#b93d5e] focus:border-transparent transition-all"
						placeholder="username"
					/>
					<p class="mt-1 text-xs text-stone-500">Optional, but recommended for campaign coordination</p>
				</div>

				<div>
					<label for="booking-experience" class="block text-sm font-medium text-stone-700 mb-2">
						Pathfinder 2E Experience
					</label>
					<select
						id="booking-experience"
						name="experience"
						class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:ring-2 focus:ring-[#b93d5e] focus:border-transparent transition-all"
					>
						<option value="none">No experience</option>
						<option value="beginner">Beginner (1-5 sessions)</option>
						<option value="intermediate">Intermediate (5-20 sessions)</option>
						<option value="experienced">Experienced (20+ sessions)</option>
					</select>
				</div>

				<div>
					<label for="booking-message" class="block text-sm font-medium text-stone-700 mb-2">
						Additional Information
					</label>
					<textarea
						id="booking-message"
						name="message"
						rows="4"
						class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:ring-2 focus:ring-[#b93d5e] focus:border-transparent transition-all resize-none"
						placeholder="Tell me about your character ideas, availability, or any questions..."
					></textarea>
				</div>
			</div>

			<div class="modal-footer">
				<button type="button" id="cancel-booking" class="inline-flex items-center justify-center font-semibold transition-all duration-250 px-6 py-3 text-base rounded-lg border-2 border-stone-300 text-stone-700 hover:bg-stone-50">
					Cancel
				</button>
				<button type="submit" class="inline-flex items-center justify-center font-semibold transition-all duration-250 px-6 py-3 text-base rounded-lg bg-gradient-to-r from-[#b93d5e] to-[#9c2d4b] text-white hover:from-[#9c2d4b] hover:to-[#832943] hover:shadow-lg hover:-translate-y-0.5">
					Submit Booking Request
				</button>
			</div>
		</form>
	</div>
</dialog>

<style>
	.booking-modal {
		position: fixed;
		inset: 0;
		z-index: 9999;
		padding: 1rem;
		border: none;
		background: transparent;
		max-width: 100vw;
		max-height: 100vh;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.booking-modal::backdrop {
		background: rgba(0, 0, 0, 0.5);
		backdrop-filter: blur(4px);
	}

	.booking-modal:not([open]) {
		display: none;
	}

	.modal-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.5);
		backdrop-filter: blur(4px);
		animation: fadeIn 0.2s ease-out;
	}

	.modal-content {
		position: relative;
		background: white;
		border-radius: 1rem;
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
		max-width: 600px;
		width: 100%;
		max-height: calc(100vh - 2rem);
		display: flex;
		flex-direction: column;
		animation: slideUp 0.3s ease-out;
	}

	.modal-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.5rem;
		border-bottom: 1px solid #e7e5e4;
	}

	.close-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.5rem;
		color: #57534e;
		transition: all 0.2s;
		border: none;
		background: transparent;
		cursor: pointer;
	}

	.close-button:hover {
		background: #f5f5f4;
		color: #292524;
	}

	.modal-body {
		flex: 1;
		overflow-y: auto;
		padding: 1.5rem;
	}

	.modal-footer {
		display: flex;
		gap: 0.75rem;
		justify-content: flex-end;
		padding: 1.5rem;
		border-top: 1px solid #e7e5e4;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes slideUp {
		from {
			transform: translateY(2rem);
			opacity: 0;
		}
		to {
			transform: translateY(0);
			opacity: 1;
		}
	}

	@media (max-width: 640px) {
		.modal-content {
			max-height: calc(100vh - 1rem);
		}

		.modal-header,
		.modal-body,
		.modal-footer {
			padding: 1rem;
		}

		.modal-footer {
			flex-direction: column;
		}

		.modal-footer button {
			width: 100%;
		}
	}
</style>

<script>
	function initBookingModal() {
		const modal = document.getElementById('booking-modal') as HTMLDialogElement;
		if (!modal) return;

		const closeButton = document.getElementById('close-modal');
		const cancelButton = document.getElementById('cancel-booking');
		const backdrop = modal.querySelector('.modal-backdrop');
		const form = document.getElementById('booking-form') as HTMLFormElement;

		// Close modal function
		function closeModal() {
			modal.close();
			form?.reset();
		}

		// Close button click
		closeButton?.addEventListener('click', closeModal);
		cancelButton?.addEventListener('click', closeModal);

		// Backdrop click
		backdrop?.addEventListener('click', closeModal);

		// Escape key
		modal.addEventListener('cancel', (e) => {
			e.preventDefault();
			closeModal();
		});

		// Form submission
		form?.addEventListener('submit', () => {
			// Form will submit naturally to formspree
			// You could add analytics tracking here
		});

		// Listen for custom event to open modal
		window.addEventListener('openBookingModal', ((e: CustomEvent) => {
			const { campaignId, campaignTitle } = e.detail;

			// Update hidden field
			const campaignInput = document.getElementById('booking-campaign') as HTMLInputElement;
			if (campaignInput && campaignId) {
				campaignInput.value = campaignId;
			}

			// Update modal title if provided
			if (campaignTitle) {
				const titleElement = modal.querySelector('.modal-header h2');
				if (titleElement) {
					titleElement.textContent = `Sign Up for ${campaignTitle}`;
				}
			}

			modal.showModal();
		}) as EventListener);
	}

	// Initialize on page load
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initBookingModal);
	} else {
		initBookingModal();
	}

	// Re-initialize on navigation (for view transitions)
	document.addEventListener('astro:page-load', initBookingModal);
</script>
