---
import {Image} from 'astro:assets';
import Badge from './Badge.astro';

interface Props {
	campaign: {
		id: string;
		data: {
			title: string;
			description: string;
			campaignType: 'adventure-path' | 'one-shot' | 'custom';
			levelRange: { min: number; max: number };
			parts: number;
			tags: string[];
			heroImage: any;
			thumbnailImage?: any;
			status: 'available' | 'full' | 'upcoming' | 'archived';
			sessionDuration: string;
			playersMin: number;
			playersMax: number;
		};
	};
}

const {campaign} = Astro.props;
const {data, id} = campaign;

// Determine status badge variant
const statusVariant = {
	'available': 'success',
	'full': 'error',
	'upcoming': 'info',
	'archived': 'default'
}[data.status] as 'success' | 'error' | 'info' | 'default';

// Campaign type label
const typeLabel = {
	'adventure-path': 'Adventure Path',
	'one-shot': 'One-Shot',
	'custom': 'Custom Campaign'
}[data.campaignType];
---

<article
	class="group relative bg-white rounded-2xl border border-stone-200 overflow-hidden hover:border-[#b93d5e] hover:shadow-xl transition-all duration-250">
	<a href={`/campaigns/${id}`} class="block no-underline">
		<!-- Image -->
		<div class="relative aspect-video overflow-hidden bg-stone-100">
			<Image
				transition:name={id}
				src={data.thumbnailImage || data.heroImage}
				alt={data.title}
				class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-250"
				width={600}
				height={338}
			/>

			<!-- Level Badge Overlay -->
			<div class="absolute top-4 left-4">
				<Badge variant="default" size="sm" class="bg-stone-900/80 text-white backdrop-blur-sm">
					Levels {data.levelRange.min}-{data.levelRange.max}
				</Badge>
			</div>

			<!-- Status Badge Overlay -->
			<div class="absolute top-4 right-4">
				<Badge variant={statusVariant} size="sm" class="backdrop-blur-sm">
					{data.status.charAt(0).toUpperCase() + data.status.slice(1)}
				</Badge>
			</div>
		</div>

		<!-- Content -->
		<div class="p-6 space-y-4">
			<!-- Type & Parts -->
			<div class="flex items-center gap-2 text-sm text-stone-600">
				<span class="font-medium text-[#9c2d4b]">{typeLabel}</span>
				{data.parts > 1 && (
					<>
						<span>•</span>
						<span>{data.parts} Parts</span>
					</>
				)}
			</div>

			<!-- Title -->
			<h3 class="text-xl font-bold text-stone-900 group-hover:text-[#b93d5e] transition-colors">
				{data.title}
			</h3>

			<!-- Description -->
			<p class="text-stone-600 line-clamp-2">
				{data.description}
			</p>

			<!-- Tags -->
			<div class="flex flex-wrap gap-2">
				{data.tags.slice(0, 3).map((tag) => (
					<Badge variant="default" size="sm">
						{tag}
					</Badge>
				))}
				{data.tags.length > 3 && (
					<Badge variant="default" size="sm">
						+{data.tags.length - 3} more
					</Badge>
				)}
			</div>

			<!-- Footer Info -->
			<div class="flex items-center gap-4 text-sm text-stone-600 pt-2 border-t border-stone-200">
				<div class="flex items-center gap-1">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
							  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
					<span>{data.sessionDuration}</span>
				</div>
				<div class="flex items-center gap-1">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
							  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
					</svg>
					<span>{data.playersMin}-{data.playersMax} players</span>
				</div>
			</div>
		</div>
	</a>
</article>
