---
interface Props {
	levelRange: { min: number; max: number };
	parts?: number;
	sessionDuration?: string;
	playersMin: number;
	playersMax: number;
	campaignType: 'adventure-path' | 'one-shot' | 'custom';
	publisher?: string;
	wikiEntry?: string;
	playersGuide?: string;
}

const {
	levelRange,
	parts,
	sessionDuration,
	playersMin,
	playersMax,
	campaignType,
	publisher,
	wikiEntry,
	playersGuide,
} = Astro.props;

const typeLabel = {
	'adventure-path': 'Adventure Path',
	'one-shot': 'One-Shot',
	'custom': 'Custom Campaign'
}[campaignType];
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 p-6 bg-stone-50 rounded-xl border border-stone-200">
	<!-- Level Range -->
	<div class="flex items-start gap-3">
		<div class="w-10 h-10 rounded-lg bg-[#fbe8eb] flex items-center justify-center flex-shrink-0">
			<svg class="w-5 h-5 text-[#9c2d4b]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
					  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
			</svg>
		</div>
		<div>
			<div class="text-sm text-stone-600 mb-1">Level Range</div>
			<div class="font-semibold text-stone-900">{levelRange.min}-{levelRange.max}</div>
		</div>
	</div>

	<!-- Session Duration -->
	{sessionDuration && (
		<div class="flex items-start gap-3">
			<div class="w-10 h-10 rounded-lg bg-[#ccfbf8] flex items-center justify-center flex-shrink-0">
				<svg class="w-5 h-5 text-[#107574]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
						  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
			</div>
			<div>
				<div class="text-sm text-stone-600 mb-1">Session Length</div>
				<div class="font-semibold text-stone-900">{sessionDuration}</div>
			</div>
		</div>
	)}

	<!-- Players -->
	<div class="flex items-start gap-3">
		<div class="w-10 h-10 rounded-lg bg-[#fef3c7] flex items-center justify-center flex-shrink-0">
			<svg class="w-5 h-5 text-[#b45309]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
					  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
			</svg>
		</div>
		<div>
			<div class="text-sm text-stone-600 mb-1">Players</div>
			<div class="font-semibold text-stone-900">{playersMin}-{playersMax}</div>
		</div>
	</div>

	<!-- Campaign Type -->
	<div class="flex items-start gap-3">
		<div class="w-10 h-10 rounded-lg bg-stone-200 flex items-center justify-center flex-shrink-0">
			<svg class="w-5 h-5 text-stone-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
					  d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
			</svg>
		</div>
		<div>
			<div class="text-sm text-stone-600 mb-1">Type</div>
			<div class="font-semibold text-stone-900">{typeLabel}</div>
		</div>
	</div>

	<!-- Parts (if applicable) -->
	{parts > 1 && (
		<div class="flex items-start gap-3">
			<div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center flex-shrink-0">
				<svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
						  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
				</svg>
			</div>
			<div>
				<div class="text-sm text-stone-600 mb-1">Parts</div>
				<div class="font-semibold text-stone-900">{parts}</div>
			</div>
		</div>
	)}

	<!-- Publisher (if available) -->
	{publisher && (
		<div class="flex items-start gap-3">
			<div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center flex-shrink-0">
				<svg class="w-5 h-5 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
						  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
			</div>
			<div>
				<div class="text-sm text-stone-600 mb-1">Publisher</div>
				<div class="font-semibold text-stone-900">{publisher}</div>
			</div>
		</div>
	)}
</div>

<!-- Wiki Link (if available) -->
{wikiEntry && (
	<div class="mb-4 pb-4 border-b border-stone-200">
		<a
			href={wikiEntry}
			target="_blank"
			rel="noopener noreferrer"
			class="flex items-center gap-2 text-sm text-[#b93d5e] hover:text-[#9c2d4b] transition-colors"
		>
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
					d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
			</svg>
			<span>View on PathfinderWiki</span>
			<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
					d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
			</svg>
		</a>
	</div>
)}


<!-- Players Guide Link (if available) -->
{playersGuide && (
	<div class="mb-4 pb-4 border-b border-stone-200">
		<a
			href={playersGuide}
			target="_blank"
			rel="noopener noreferrer"
			class="flex items-center gap-2 text-sm text-[#b93d5e] hover:text-[#9c2d4b] transition-colors"
		>
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
					  d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
			</svg>
			<span>View Players Guide</span>
			<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
					  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
			</svg>
		</a>
	</div>
)}
